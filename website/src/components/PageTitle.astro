---
// Starlight's page title, plus the page for language models: copy it as Markdown, or open it in Claude or ChatGPT.
// The Markdown comes from the page's .md twin (src/pages/[...slug].md.ts).
import Default from '@astrojs/starlight/components/PageTitle.astro';

const md = `${Astro.url.pathname.replace(/\/$/, '')}.md`;
const mdUrl = new URL(md, Astro.site ?? Astro.url).href;
const ask = encodeURIComponent(`Read ${mdUrl} so you can help me with Zombye.`);
---

<Default />
<div class="page-ai not-content">
	<button type="button" data-md={md}>Copy page as Markdown</button>
	<a href={md}>View as Markdown</a>
	<a href={`https://claude.ai/new?q=${ask}`} target="_blank" rel="noopener">Open in Claude</a>
	<a href={`https://chatgpt.com/?q=${ask}`} target="_blank" rel="noopener">Open in ChatGPT</a>
</div>

<script>
	document.querySelectorAll<HTMLButtonElement>('.page-ai button[data-md]').forEach((button) => {
		button.addEventListener('click', async () => {
			const label = button.textContent;
			try {
				const text = await (await fetch(button.dataset.md!)).text();
				await navigator.clipboard.writeText(text);
				button.textContent = 'Copied';
			} catch {
				button.textContent = 'Could not copy';
			}
			setTimeout(() => (button.textContent = label), 1600);
		});
	});
</script>

<style>
	.page-ai {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 14px;
		margin-top: 0.6rem;
		font-size: var(--sl-text-xs);
	}
	.page-ai a,
	.page-ai button {
		color: var(--sl-color-gray-3);
		text-decoration: none;
		background: none;
		border: 0;
		padding: 0;
		font: inherit;
		cursor: pointer;
	}
	.page-ai a:hover,
	.page-ai button:hover {
		color: var(--sl-color-accent);
	}
</style>
