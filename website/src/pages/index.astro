---
import '@fontsource/anton/400.css';
import '@fontsource-variable/inter';
import { Image } from 'astro:assets';
import crowd from '../assets/shots/crowd.jpg';
import night from '../assets/shots/night.jpg';
import yard from '../assets/shots/yard.jpg';
import street from '../assets/shots/street.jpg';
import firstPerson from '../assets/shots/first-person.jpg';
import observe from '../assets/observe.txt?raw';

const repo = 'https://github.com/deadcommons/zombye';
const discord = 'https://discord.gg/y7NsmVG2br';
const email = 'hello@getzombye.com';
// Set when the Steam page is live; until then the buttons say it's coming.
const steam: string | null = null;
const socials = [
	['Discord', discord],
	['GitHub', repo],
	['X', 'https://x.com/zombyegame'],
	['Bluesky', 'https://bsky.app/profile/getzombye.com'],
	['YouTube', 'https://www.youtube.com/@zombyegame'],
	['Instagram', 'https://www.instagram.com/zombyegame'],
	['Reddit', 'https://www.reddit.com/r/zombyegame'],
];
const site = (Astro.site?.href ?? '').replace(/\/$/, '');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docs = (path = '') => `${base}/docs/${path}`;

const features = [
	{
		title: 'Fast, and built in Rust',
		text: 'A native engine written from scratch in Rust. No virtual machine, no garbage collector pauses, no legacy code. Twenty thousand zombies simulated in about a millisecond a tick.',
	},
	{
		title: 'Runs where you are',
		text: 'Mac, Linux and Windows from the same source. Native on Apple silicon with Metal, Vulkan on Linux, DirectX or Vulkan on Windows.',
	},
	{
		title: 'Agent first',
		text: 'Let your agent play. Everything in the game is reachable over MCP: look, move, loot, fight, craft, talk, take screenshots, run a server. Claude Code or any MCP client.',
	},
	{
		title: 'Open source. It\'s yours.',
		text: 'Free to play, read, fork, build and host. Code under MIT or Apache-2.0. No account, no fee, no closed editor.',
	},
	{
		title: 'Moddable by nature',
		text: 'Everything is a data file you can change: items, weapons, recipes, loot, buildings, zombie numbers. Edit a file, start the game, play your mod.',
	},
	{
		title: '3D first',
		text: 'A real 3D world, not sprites. Play from above or through your survivor\'s eyes, and switch between the two on the fly with one key.',
	},
];

const numbers = [
	['20,000+', 'zombies simulated on a 1 km map'],
	['1.1 ms', 'average server tick with a horde of 900 on your heels'],
	['410 m', 'how far off a loud noise pulls zombies from'],
	['1 seed', 'the same town and the same dead, every time'],
];

const zombies = [
	['Wander', 'drifts about until something catches its ear'],
	['Investigate', 'heads for the noise you made, not for you'],
	['Chase', 'has seen you and is coming'],
	['Thump', 'batters the door you hid behind until it gives'],
];

const modExample = `// items/weapons.ron
(
    id: "nail_bat",
    name: "Nail bat",
    category: LongBlunt,
    damage: (32.0, 44.0),
    range: 1.25,
    arc_degrees: 110.0,
    crit_chance: 0.18,
    // ...
),

// items/recipes.ron
(id: "make_nail_bat", name: "Hammer nails into a bat", secs: 20.0,
    inputs: [(item: "baseball_bat"), (item: "nails")],
    tools: [Item("claw_hammer")],
    outputs: [(item: "nail_bat")]),`;

const milestones = [
	['M0', 'Tech spike', 'done'],
	['M1', 'World and visibility', 'done'],
	['M2', 'Player and combat', 'now'],
	['M3', 'Population', 'now'],
	['M4', 'Survival and items', 'done'],
	['M5', 'Content and art', 'now'],
	['M6', 'Multiplayer and mods', 'now'],
	['M7', 'Hosting launch', 'next'],
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Zombye: open-source zombie survival with a town full of dead</title>
		<meta name="description" content="Slow-burn zombie survival built from scratch in Rust and in real 3D. Fast, free and open source, moddable from plain data files, and made so AI agents can play it over MCP. Mac, Linux and Windows." />
		<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
		<meta property="og:title" content="Zombye" />
		<meta property="og:description" content="Twenty thousand simulated zombies, one small town. Open source, moddable, and playable by AI agents." />
		<meta property="og:type" content="website" />
		<meta property="og:image" content={`${site}${base}/og.jpg`} />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<header class="nav">
			<a class="wordmark" href={`${base}/`}>Zombye</a>
			<nav>
				<a href="#horde">Performance</a>
				<a href="#views">Views</a>
				<a href="#survive">Survive</a>
				<a href="#agents">Agents</a>
				<a href="#mods">Mods</a>
				<a href={docs()}>Docs</a>
				<a href={discord}>Discord</a>
				<a href={repo}>GitHub</a>
				<a class="pill play-pill" href={docs('start/install')}>▶ Play</a>
			</nav>
		</header>

		<section class="hero">
			<Image class="hero-img" src={crowd} alt="A survivor backs across a street at dusk with a dozen zombies closing in, their shadows long on the road." widths={[800, 1280, 1600]} sizes="100vw" loading="eager" />
			<div class="hero-shade"></div>
			<div class="hero-text wrap">
				<p class="tag">Pre-alpha · free and open source · Mac, Linux, Windows</p>
				<h1>Twenty thousand dead.<br /><span>One small town.</span></h1>
				<p class="lede">
					Zombye is slow-burn zombie survival, built from scratch in Rust and in real 3D. Fast, open
					source, moddable down to the last number, and made so your AI agent can play it too.
				</p>
				<div class="ctas">
					<a class="btn play" href={docs('start/install')}>
						<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M7 4.5v15l13-7.5z" fill="currentColor" /></svg>
						Play now, free
					</a>
					{
						steam ? (
							<a class="btn" href={steam}>Wishlist on Steam</a>
						) : (
							<a class="btn" href="#early">Steam page coming soon</a>
						)
					}
					<a class="btn ghost" href={discord}>Join the Discord</a>
				</div>
			</div>
		</section>

		<section class="numbers">
			<dl class="wrap">
				{
					numbers.map(([n, text]) => (
						<div>
							<dt>{n}</dt>
							<dd>{text}</dd>
						</div>
					))
				}
			</dl>
		</section>

		<section class="features wrap">
			{
				features.map((f) => (
					<article>
						<h3>{f.title}</h3>
						<p>{f.text}</p>
					</article>
				))
			}
		</section>

		<section id="horde" class="split wrap">
			<figure>
				<Image src={crowd} alt="A dozen zombies cross a street toward a survivor, their shadows long on the road." widths={[640, 1280]} sizes="(max-width: 900px) 100vw, 580px" />
				<figcaption>From the game. Every one of them has somewhere it's going.</figcaption>
			</figure>
			<div class="copy">
				<p class="kicker">Performance</p>
				<h2>They don't wait for you to show up.</h2>
				<p>
					Most games only run the zombies near you. Zombye runs all of them. Close ones see, hear, chase and
					batter doors. Far ones wander the woods and drift toward whatever was loud. On our test map that's
					about 1,300 up close and 20,000 further out, in about a millisecond a tick.
				</p>
				<p>
					So a broken window on one side of town changes what's waiting on the other side ten minutes
					later. Hordes build up and move on. Nothing spawns behind you to keep things tense.
				</p>
				<p>
					And it's deterministic: the same seed and the same moves give the same town, the same zombies
					and the same ending. Replay a fight from a save. Race a friend through the same town. A shared
					town of the day is on the way.
				</p>
				<a class="more" href={docs('play/world')}>How the world works →</a>
			</div>
		</section>

		<section id="views" class="views">
			<div class="wrap">
				<p class="kicker">3D first</p>
				<h2>From above, or through their eyes.</h2>
				<p class="views-lede">
					The town is real 3D all the way down, so the camera is yours. Plan from above with four camera
					angles, then drop to first person when you'd rather not see what's round the corner. One key,
					mid-game, same world.
				</p>
				<div class="pair">
					<figure>
						<Image src={yard} alt="The town seen from above: houses, gardens and zombies between them." widths={[640, 1280]} sizes="(max-width: 900px) 100vw, 570px" />
						<figcaption>From above</figcaption>
					</figure>
					<figure>
						<Image src={firstPerson} alt="First person: long grass in a garden, a house to the left and zombies on the street beyond." widths={[640, 960]} sizes="(max-width: 900px) 100vw, 570px" />
						<figcaption>First person</figcaption>
					</figure>
				</div>
			</div>
		</section>

		<section id="survive" class="split wrap">
			<div class="copy">
				<p class="kicker">Survive</p>
				<h2>An ordinary person. An ordinary town. The day after.</h2>
				<p>
					No quest markers and no superpowers. You wake up in a bedroom in an early-1990s American small town
					ringed by forest, and everything you need is somewhere in those houses: tins in the cupboards,
					a bat in the wardrobe, gauze in the bathroom cabinet.
				</p>
				<p>
					Zombies see you in a cone and hear you through walls. Running is loud, sneaking is slow, and a
					door you shut behind you only holds for so long.
				</p>
				<ul class="states">
					{
						zombies.map(([name, text]) => (
							<li>
								<b>{name}</b> {text}
							</li>
						))
					}
				</ul>
				<a class="more" href={docs('play/first-night')}>Your first night →</a>
			</div>
			<figure>
				<Image src={night} alt="Night. A survivor stands in a dark garden by a small campfire; one window of the house is lit." widths={[640, 960]} sizes="(max-width: 900px) 100vw, 580px" />
				<figcaption>Night is properly dark. A fire or a lit window shows from a long way off.</figcaption>
			</figure>
		</section>

		<section class="body-list wrap">
			<div>
				<h3>Your body keeps score</h3>
				<p>Scratches, gashes and bites on ten body parts. Bleeding, festering, fever, and the infection you won't know you have until it's too late.</p>
			</div>
			<div>
				<h3>Loot that makes sense</h3>
				<p>Fridges hold food, wardrobes hold clothes, the garage holds a crowbar if you're lucky. Food goes off. Everything has a weight.</p>
			</div>
			<div>
				<h3>Craft from junk</h3>
				<p>Rip a T-shirt into rags, wash them in clean water, dress the wound. Get better at what you do: nine skills, raised only by doing.</p>
			</div>
		</section>

		<section id="agents" class="agents">
			<div class="wrap split rev">
				<div class="copy">
					<p class="kicker">Agents</p>
					<h2>Your agent can play too.</h2>
					<p>
						<code>zombye-server --mcp</code> is a Model Context Protocol server. Add it to Claude Code, or any
						MCP client, and your agent gets the same view and the same moves a player has: look around, open
						doors, search cupboards, swing a bat, dress a wound, sleep.
					</p>
					<p>
						Time only moves when the agent asks it to, so it can think as long as it likes between steps. It can
						take screenshots of the world, run the same fight again from a save, and tell you exactly why it
						died.
					</p>
					<pre class="cmd"><code>claude mcp add zombye -- ./target/release/zombye-server --mcp</code></pre>
					<a class="more" href={docs('agents/tutorial')}>Tutorial: an agent survives →</a>
				</div>
				<div class="terminal" aria-label="What an agent sees when it calls observe">
					<div class="bar"><i></i><i></i><i></i><span>observe</span></div>
					<pre>{observe}</pre>
				</div>
			</div>
		</section>

		<section id="mods" class="split wrap">
			<div class="copy">
				<p class="kicker">Mods</p>
				<h2>Everything is a data file.</h2>
				<p>
					Items, weapons, recipes, loot tables, furniture, houses, how many zombies live in the woods, what
					a door sounds like when it breaks: it's all plain text in <code>assets/data</code>, checked when the
					game loads it, with errors that point at the line.
				</p>
				<p>
					Copy the folder, change it, start the game with <code>--data</code>. Or ask your agent to make the
					mod, play it, and show you a screenshot.
				</p>
				<a class="more" href={docs('modding/first-mod')}>Make a nail bat in ten minutes →</a>
			</div>
			<pre class="code"><code>{modExample}</code></pre>
		</section>

		<section class="town">
			<div class="wrap town-shot"><Image src={street} alt="A street at the edge of town: houses with porches, a sidewalk with hydrants and bins, and the forest across the road." widths={[800, 1280]} sizes="(max-width: 1192px) 100vw, 1160px" /></div>
			<p class="wrap caption">Every town is generated from a seed: a main street, a square, shops, cul-de-sacs and woods all round.</p>
		</section>

		<section id="early" class="early">
			<div class="wrap">
				<p class="kicker">Get in early</p>
				<h2>It's pre-alpha. Come and break it.</h2>
				<div class="cards">
					<article>
						<h3>Steam</h3>
						<p>The store page is on its way. Wishlisting will be the best way to help once it's up.</p>
						{steam ? <a class="btn primary" href={steam}>Wishlist on Steam</a> : <span class="soon">Page coming soon</span>}
					</article>
					<article>
						<h3>Playtest</h3>
						<p>A first public playtest is coming. Sign-ups will open in the Discord, so that's where to wait.</p>
						<a class="btn" href={discord}>Join the Discord</a>
					</article>
					<article>
						<h3>Play it today</h3>
						<p>The source is all there. Build it in a few minutes and you're in the bedroom where it starts.</p>
						<a class="btn primary" href={docs('start/install')}>▶ Play now</a>
					</article>
				</div>
			</div>
		</section>

		<section class="open wrap">
			<div>
				<p class="kicker">Open source</p>
				<h2>Yours to read, run, fork and host.</h2>
				<p>
					Code under MIT or Apache-2.0. Art and audio under CC BY-NC-SA 4.0, free for mods and fan work.
					Record, stream and monetise videos of it without asking. Self-hosting is free forever; official
					one-click hosting is how we'll pay for development.
				</p>
				<div class="ctas">
					<a class="btn primary" href={repo}>Star it on GitHub</a>
					<a class="btn" href={`${repo}/blob/main/CONTRIBUTING.md`}>Contribute</a>
				</div>
			</div>
			<ol class="roadmap">
				{
					milestones.map(([id, name, state]) => (
						<li class={state}>
							<span class="id">{id}</span>
							<span class="name">{name}</span>
							<span class="state">{state === 'now' ? 'in progress' : state}</span>
						</li>
					))
				}
				<li class="link"><a href="https://github.com/orgs/deadcommons/projects/2">The full board on GitHub →</a></li>
			</ol>
		</section>

		<footer>
			<div class="wrap foot">
				<span class="wordmark small">Zombye</span>
				<nav>
					<a href={docs()}>Docs</a>
					{socials.map(([name, href]) => <a href={href}>{name}</a>)}
					<a href={`mailto:${email}`}>{email}</a>
					<a href={`${repo}/blob/main/README.md#license`}>Licence</a>
				</nav>
				<p>
					© 2026 Grillo Ltd (trading as Dead Commons) and the Zombye contributors. Zombye and Dead Commons
					are trademarks.
				</p>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--bone: #f1e9da;
		--paper: #f8f3e9;
		--ink: #1b1916;
		--ink-2: #4a443c;
		--blood: #b8322a;
		--mustard: #d69e2e;
		--night: #13161a;
		--display: 'Anton', Impact, 'Arial Narrow', sans-serif;
		color-scheme: light;
	}
	* {
		box-sizing: border-box;
	}
	html {
		scroll-behavior: smooth;
	}
	body {
		margin: 0;
		background: var(--bone);
		color: var(--ink);
		font: 17px/1.6 'Inter Variable', system-ui, sans-serif;
		-webkit-font-smoothing: antialiased;
	}
	a {
		color: inherit;
	}
	code {
		font-family: ui-monospace, 'SF Mono', Menlo, monospace;
		font-size: 0.88em;
	}
	img {
		display: block;
		max-width: 100%;
		height: auto;
	}
	.wrap {
		width: min(1160px, 100% - 32px);
		margin-inline: auto;
	}
	h1,
	h2,
	h3,
	.wordmark,
	.kicker,
	.tag {
		font-family: var(--display);
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		line-height: 1.02;
	}
	h2 {
		font-size: clamp(2rem, 4.5vw, 3.2rem);
		margin: 0.2em 0 0.5em;
	}
	h3 {
		font-size: 1.35rem;
		margin: 0 0 0.4em;
	}
	.kicker {
		color: var(--blood);
		font-size: 1rem;
		letter-spacing: 0.12em;
		margin: 0;
	}

	/* Nav */
	.nav {
		position: absolute;
		inset: 0 0 auto;
		z-index: 3;
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 18px max(16px, calc((100% - 1160px) / 2));
		color: var(--bone);
	}
	.wordmark {
		font-size: 2rem;
		text-decoration: none;
		letter-spacing: 0.05em;
	}
	.wordmark.small {
		font-size: 1.6rem;
	}
	.nav nav {
		display: flex;
		gap: 22px;
		align-items: center;
		font-weight: 600;
		font-size: 0.95rem;
	}
	.nav nav a {
		text-decoration: none;
		opacity: 0.9;
	}
	.nav nav a:hover {
		opacity: 1;
		text-decoration: underline;
	}
	.pill {
		border: 1.5px solid currentColor;
		border-radius: 999px;
		padding: 5px 14px;
	}

	/* Hero */
	.hero {
		position: relative;
		min-height: min(92vh, 860px);
		display: flex;
		align-items: flex-end;
		color: var(--bone);
		background: var(--night);
		overflow: hidden;
	}
	.hero-img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 70% 50%;
	}
	.hero-shade {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, rgba(10, 10, 12, 0.55) 0%, rgba(10, 10, 12, 0) 22%),
			linear-gradient(0deg, rgba(12, 11, 10, 0.94) 0%, rgba(12, 11, 10, 0.7) 40%, rgba(12, 11, 10, 0.15) 78%);
	}
	.hero-text {
		position: relative;
		padding-block: 120px 64px;
	}
	.tag {
		display: inline-block;
		background: var(--blood);
		color: var(--bone);
		font-size: 0.95rem;
		letter-spacing: 0.1em;
		padding: 6px 12px 4px;
		margin: 0 0 18px;
		transform: rotate(-1.5deg);
	}
	h1 {
		font-size: clamp(2.6rem, 7vw, 5.4rem);
		margin: 0 0 0.25em;
		max-width: 22ch;
		text-shadow: 0 2px 24px rgba(0, 0, 0, 0.5);
	}
	h1 span {
		color: var(--mustard);
	}
	.lede {
		font-size: clamp(1.05rem, 2vw, 1.3rem);
		max-width: 36em;
		margin: 0 0 28px;
		color: #eae2d2;
	}
	.ctas {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px;
	}
	.btn {
		display: inline-block;
		padding: 12px 20px;
		border-radius: 6px;
		border: 2px solid currentColor;
		font-weight: 700;
		text-decoration: none;
		transition: transform 0.15s ease;
	}
	.btn:hover {
		transform: translateY(-2px);
	}
	.btn.primary {
		background: var(--blood);
		border-color: var(--blood);
		color: var(--bone);
	}
	.btn.play {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		background: var(--blood);
		border-color: var(--blood);
		color: var(--bone);
		font-family: var(--display);
		font-weight: 400;
		font-size: 1.5rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		line-height: 1;
		padding: 14px 28px 12px 22px;
		box-shadow: 0 10px 30px -8px rgba(184, 50, 42, 0.7);
	}
	.play-pill {
		background: var(--blood);
		border-color: var(--blood);
	}
	.btn.ghost {
		border-color: transparent;
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	/* Numbers */
	.numbers {
		background: var(--ink);
		color: var(--bone);
	}
	.numbers dl {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 24px;
		margin-block: 0;
		padding-block: 30px;
	}
	.numbers dt {
		font-family: var(--display);
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1;
		color: var(--mustard);
	}
	.numbers dd {
		margin: 8px 0 0;
		color: #cfc7b8;
		font-size: 0.95rem;
		max-width: 22ch;
	}

	/* Views */
	.views {
		background: var(--night);
		color: var(--bone);
		padding-block: 72px;
	}
	.views-lede {
		max-width: 44em;
		color: #cfc7b8;
	}
	.pair {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 20px;
		margin-top: 28px;
	}
	.pair img {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
