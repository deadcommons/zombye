#!/usr/bin/env python3
"""zboard: a web dashboard for the agents zwork runs on the build box. See docs/remote-dev.md.

A card per issue being worked: its state, model, requests made so far, commits, the PR, the agent's
latest messages and every review picture it has rendered, newest first, as they appear. From the page
you start an issue, send an agent feedback, stop it, or approve: mark the PR ready, squash-merge it
(which closes the issue), set the board to Done and remove the worktree.

    zboard [PORT]     serves on 127.0.0.1 only (default 8765); reach it over SSH:
                      ssh -fN -L 8765:localhost:8765 zombye-build, then http://localhost:8765

Plain Python 3, standard library only. It reads what zwork leaves in ~/wt and runs zwork and gh.
"""
import json
import os
import re
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

HOME = Path.home()
WT = Path(os.environ.get("ZWORK_DIR", HOME / "wt"))
STATE = WT / ".zwork"
REPO = "deadcommons/zombye"
PROJECT_ID = "PVT_kwDOFK2jds4BoamE"
STATUS_FIELD = "PVTSSF_lADOFK2jds4BoamEzhm60wc"
STATUS_DONE = "98236657"
MODELS = ["github-copilot/claude-sonnet-5.5", "github-copilot/claude-opus-5.5", "github-copilot/claude-haiku-5.5",
          "github-copilot/gpt-6.1-sol", "github-copilot/gemini-4-argon"]

# Slow lookups (gh) are refreshed in the background so the page stays quick.
cache = {"prs": {}, "issues": [], "lock": threading.Lock()}


def run(cmd, timeout=120):
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    return r.returncode, (r.stdout + r.stderr).strip()


def refresher():
    while True:
        try:
            _, out = run(["gh", "pr", "list", "-R", REPO, "--state", "open", "--limit", "100",
                          "--json", "number,headRefName,isDraft,url,mergeable"])
            prs = {p["headRefName"]: p for p in json.loads(out or "[]")}
            _, out = run(["gh", "issue", "list", "-R", REPO, "--state", "open", "--limit", "200",
                          "--json", "number,title,milestone"])
            issues = [{"number": i["number"], "title": i["title"], "milestone": (i.get("milestone") or {}).get("title", "")}
                      for i in json.loads(out or "[]")]
            with cache["lock"]:
                cache["prs"], cache["issues"] = prs, sorted(issues, key=lambda i: i["number"])
        except Exception as e:  # keep going: the page shows what it last knew
            print("refresh:", e, file=sys.stderr)
        time.sleep(20)


def running(n):
    return subprocess.run(["tmux", "has-session", "-t", f"zw-{n}"], capture_output=True).returncode == 0


def read(p, default=""):
    try:
        return Path(p).read_text().strip()
    except OSError:
        return default


def agent_log(n, limit=40):
    """The agent's events, readable, and how many model requests it has made."""
    lines, requests, tokens = [], 0, 0
    try:
        with open(STATE / str(n) / "log.jsonl") as f:
            for raw in f:
                try:
                    e = json.loads(raw)
                except ValueError:
                    continue
                part = e.get("part") or {}
                if e.get("type") == "text" and part.get("text"):
                    lines.append({"kind": "text", "text": part["text"]})
                elif e.get("type") == "tool_use":
                    st = part.get("state") or {}
                    title = st.get("title") or json.dumps(st.get("input", ""))[:160]
                    lines.append({"kind": "tool", "text": f"{part.get('tool', '?')}: {title}"[:300]})
                elif e.get("type") == "step_finish":
                    requests += 1
                    tokens += (part.get("tokens") or {}).get("output", 0)
                elif e.get("type") == "error":
                    lines.append({"kind": "error", "text": json.dumps(e.get("error", e))[:400]})
    except OSError:
        pass
    return lines[-limit:], requests, tokens


def issue_state(d):
    n = d.name
    s = STATE / n
    if running(n):
        st = "running"
    elif (s / "exit").exists():
        st = "finished" if read(s / "exit") == "0" else f"failed ({read(s / 'exit')})"
    else:
        st = "stopped"
    _, ahead = run(["git", "-C", str(d), "rev-list", "--count", "origin/main..HEAD"], 10)
    shots = sorted((d / "review").glob("*.png"), key=lambda p: p.stat().st_mtime, reverse=True)
    log, requests, tokens = agent_log(n)
    with cache["lock"]:
        pr = cache["prs"].get(f"issue-{n}")
    return {
        "n": int(n), "title": read(s / "title"), "state": st, "model": read(s / "model").split("/")[-1],
        "ahead": ahead if ahead.isdigit() else "?", "requests": requests, "tokens": tokens,
        "pr": pr, "log": log,
        "shots": [{"name": p.name, "v": int(p.stat().st_mtime)} for p in shots],
    }


def state():
    issues = [issue_state(d) for d in sorted(WT.glob("[0-9]*"), key=lambda d: int(d.name)) if d.is_dir()]
    worked = {i["n"] for i in issues}
    with cache["lock"]:
        startable = [i for i in cache["issues"] if i["number"] not in worked]
    return {"issues": issues, "startable": startable, "models": MODELS, "time": time.strftime("%H:%M:%S")}


def approve(n):
    """Owner's approval: PR ready, squash-merged (closing the issue), board Done, worktree removed."""
    with cache["lock"]:
        pr = cache["prs"].get(f"issue-{n}")
    if not pr:
        return 1, f"no open PR for issue-{n} yet"
    num = str(pr["number"])
    if pr.get("isDraft"):
        code, out = run(["gh", "pr", "ready", num, "-R", REPO])
        if code:
            return code, out
    code, out = run(["gh", "pr", "merge", num, "-R", REPO, "--squash", "--delete-branch"])
    if code:
        return code, out
    _, items = run(["gh", "project", "item-list", "2", "--owner", "deadcommons", "--limit", "500", "--format", "json"])
    for it in json.loads(items or "{}").get("items", []):
        if (it.get("content") or {}).get("number") == n:
            run(["gh", "project", "item-edit", "--project-id", PROJECT_ID, "--id", it["id"],
                 "--field-id", STATUS_FIELD, "--single-select-option-id", STATUS_DONE])
    run(["zwork", "rm", str(n)])
    run(["git", "-C", str(HOME / "zombye"), "pull", "-q"])
    return 0, f"merged PR #{num}; #{n} closed and Done"


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def send(self, code, body, ctype="application/json"):
        data = body if isinstance(body, bytes) else body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store" if ctype != "image/png" else "max-age=86400")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        path = self.path.split("?")[0]
        if path == "/":
            return self.send(200, PAGE, "text/html; charset=utf-8")
        if path == "/api/state":
            return self.send(200, json.dumps(state()))
        m = re.fullmatch(r"/shot/(\d+)/([\w.-]+\.png)", path)
        if m:
            p = WT / m.group(1) / "review" / m.group(2)
            if p.is_file():
                return self.send(200, p.read_bytes(), "image/png")
        self.send(404, '{"error":"not found"}')

    def do_POST(self):
        try:
            body = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))) or "{}")
            n = str(int(body.get("n", 0)))
        except (ValueError, TypeError):
            return self.send(400, '{"error":"bad request"}')
        action = self.path
        if action == "/api/start":
            model = body.get("model") if body.get("model") in MODELS else MODELS[0]
            code, out = run(["zwork", "start", n, model])
        elif action == "/api/say":
            msg = str(body.get("message", "")).strip()
            code, out = (1, "say something first") if not msg else run(["zwork", "say", n, msg])
        elif action == "/api/stop":
            code, out = run(["zwork", "stop", n])
        elif action == "/api/approve":
            code, out = approve(int(n))
        else:
            return self.send(404, '{"error":"not found"}')
        self.send(200 if code == 0 else 409, json.dumps({"ok": code == 0, "message": out[-600:]}))


