#!/usr/bin/env python3
"""zboard: the owner's screen onto the agents zwork runs on the build box. See docs/remote-dev.md.

One big screen in the middle: the selected issue's review pictures, newest first, as they're rendered,
or, with Play, the game itself (any issue's build, or main's) running on the play box and streamed by
Amazon DCV, played with keyboard and mouse. Beside it, the issues being worked, each with only its
state, time and short to-do list. Under it: feedback to the agent, Stop, and Approve (PR ready,
squash-merged, which closes the issue; board Done; worktree removed). Start any open issue, grouped by
milestone, with a model.

    zboard [PORT]     serves on 127.0.0.1 only (default 8765); reach it over the SSH tunnel:
                      ssh -fN zombye-board, then http://localhost:8765 (the stream is :8080)

Plain Python 3, standard library only. It reads what zwork leaves in ~/wt and runs zwork, zgpu and gh.
"""
import json
import os
import re
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

HOME = Path.home()
WT = Path(os.environ.get("ZWORK_DIR", HOME / "wt"))
STATE = WT / ".zwork"
REPO = "deadcommons/zombye"
PROJECT_ID = "PVT_kwDOFK2jds4BoamE"
STATUS_FIELD = "PVTSSF_lADOFK2jds4BoamEzhm60wc"
STATUS_DONE = "98236657"
PLAY_HOST = os.environ.get("ZOMBYE_PLAY_HOST", "zombye-gpu")
MODELS = ["github-copilot/claude-sonnet-5.5", "github-copilot/claude-opus-5.5", "github-copilot/claude-haiku-5.5",
          "github-copilot/gpt-6.1-sol", "github-copilot/gemini-4-argon"]

# Slow lookups (gh) are refreshed in the background so the page stays quick.
cache = {"prs": {}, "issues": [], "lock": threading.Lock()}
play = {"target": None, "state": "idle", "message": "", "since": 0, "lock": threading.Lock()}


def run(cmd, timeout=600, env=None):
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=env)
    return r.returncode, (r.stdout + r.stderr).strip()


def refresher():
    while True:
        try:
            _, out = run(["gh", "pr", "list", "-R", REPO, "--state", "open", "--limit", "100",
                          "--json", "number,headRefName,isDraft,url"])
            prs = {p["headRefName"]: p for p in json.loads(out or "[]")}
            _, out = run(["gh", "issue", "list", "-R", REPO, "--state", "open", "--limit", "200",
                          "--json", "number,title,milestone"])
            issues = [{"number": i["number"], "title": i["title"], "milestone": (i.get("milestone") or {}).get("title", "")}
                      for i in json.loads(out or "[]")]
            with cache["lock"]:
                cache["prs"], cache["issues"] = prs, sorted(issues, key=lambda i: i["number"])
        except Exception as e:  # keep going: the page shows what it last knew
            print("refresh:", e, file=sys.stderr)
        time.sleep(20)


def running(n):
    return subprocess.run(["tmux", "has-session", "-t", f"zw-{n}"], capture_output=True).returncode == 0


def read(p, default=""):
    try:
        return Path(p).read_text().strip()
    except OSError:
        return default


def agent_log(n, limit=60):
    """The agent's events, readable; its latest to-do list; requests made; first and last event times."""
    lines, todos, requests, first, last = [], [], 0, None, None
    try:
        with open(STATE / str(n) / "log.jsonl") as f:
            for raw in f:
                try:
                    e = json.loads(raw)
                except ValueError:
                    continue
                ts = e.get("timestamp")
                if ts:
                    first, last = first or ts, ts
                part = e.get("part") or {}
                if e.get("type") == "text" and part.get("text"):
                    lines.append({"kind": "text", "text": part["text"]})
                elif e.get("type") == "tool_use":
                    st = part.get("state") or {}
                    if part.get("tool") == "todowrite" and isinstance((st.get("input") or {}).get("todos"), list):
                        todos = [{"text": t.get("content", ""), "status": t.get("status", "pending")}
                                 for t in st["input"]["todos"]]
                    title = st.get("title") or json.dumps(st.get("input", ""))[:160]
                    lines.append({"kind": "tool", "text": f"{part.get('tool', '?')}: {title}"[:300]})
                elif e.get("type") == "step_finish":
                    requests += 1
                elif e.get("type") == "error":
                    lines.append({"kind": "error", "text": json.dumps(e.get("error", e))[:400]})
    except OSError:
        pass
    return lines[-limit:], todos, requests, first, last


def issue_state(d):
    n = d.name
    s = STATE / n
    log, todos, requests, first, last = agent_log(n)
    with cache["lock"]:
        pr = cache["prs"].get(f"issue-{n}")
    if running(n):
        st, end = "working", time.time() * 1000
    elif (s / "exit").exists() and read(s / "exit") != "0":
        st, end = "failed", last
    elif (s / "exit").exists():
        st, end = ("ready for review" if pr else "finished"), last
    else:
        st, end = "stopped", last
    shots = sorted((d / "review").glob("*.png"), key=lambda p: p.stat().st_mtime, reverse=True)
    # The one line the sidebar shows: the step under way, else the agent's latest words
    now = next((t["text"] for t in todos if t["status"] == "in_progress"), "")
    if not now:
        texts = [l["text"] for l in log if l["kind"] == "text"]
        now = texts[-1].strip().split("\n")[0][:160] if texts else ""
    return {
        "n": int(n), "title": read(s / "title"), "state": st, "model": read(s / "model").split("/")[-1],
        "requests": requests, "minutes": int(((end or 0) - (first or end or 0)) / 60000),
        "pr": pr, "log": log, "todos": todos, "now": now,
        "shots": [{"name": p.name, "v": int(p.stat().st_mtime)} for p in shots],
    }


def state():
    issues = [issue_state(d) for d in sorted(WT.glob("[0-9]*"), key=lambda d: int(d.name)) if d.is_dir()]
    worked = {i["n"] for i in issues}
    with cache["lock"]:
        startable = [i for i in cache["issues"] if i["number"] not in worked]
    with play["lock"]:
        p = {k: play[k] for k in ("target", "state", "message", "since")}
    return {"issues": issues, "startable": startable, "models": MODELS, "play": p, "time": time.strftime("%H:%M:%S")}


def approve(n):
    """Owner's approval: PR ready, squash-merged (closing the issue), board Done, worktree removed."""
    with cache["lock"]:
        pr = cache["prs"].get(f"issue-{n}")
    if not pr:
        return 1, f"no open PR for issue-{n} yet"
    num = str(pr["number"])
    if pr.get("isDraft"):
        code, out = run(["gh", "pr", "ready", num, "-R", REPO])
        if code:
            return code, out
    code, out = run(["gh", "pr", "merge", num, "-R", REPO, "--squash", "--delete-branch"])
    if code:
        return code, out
    _, items = run(["gh", "project", "item-list", "2", "--owner", "deadcommons", "--limit", "500", "--format", "json"])
    for it in json.loads(items or "{}").get("items", []):
        if (it.get("content") or {}).get("number") == n:
            run(["gh", "project", "item-edit", "--project-id", PROJECT_ID, "--id", it["id"],
                 "--field-id", STATUS_FIELD, "--single-select-option-id", STATUS_DONE])
    run(["zwork", "rm", str(n)])
    run(["git", "-C", str(HOME / "zombye"), "pull", "-q"])
    return 0, f"merged PR #{num}; #{n} closed and Done"


def start_play(target):
    """Build target's client (an issue number or main) and start it on the play box, in the background."""
    with play["lock"]:
        if play["state"] == "building":
            return 1, f"already building {play['target']}"
        play.update(target=target, state="building", message="building…", since=time.time())

    def work():
        env = dict(os.environ, ZOMBYE_PLAY_HOST=PLAY_HOST)
        code, out = run(["zwork", "play", target], timeout=1200, env=env)
        with play["lock"]:
            play.update(state="running" if code == 0 else "failed", message=out.splitlines()[-1] if out else "",
                        since=time.time())
    threading.Thread(target=work, daemon=True).start()
    return 0, f"building {target}…"


def stop_play():
    code, out = run(["zgpu", "--stop"], env=dict(os.environ, ZOMBYE_GPU_HOST=PLAY_HOST))
    with play["lock"]:
        play.update(target=None, state="idle", message="", since=time.time())
    return code, out


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def send(self, code, body, ctype="application/json"):
        data = body if isinstance(body, bytes) else body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store" if ctype != "image/png" else "max-age=86400")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        path = self.path.split("?")[0]
        if path == "/":
            return self.send(200, PAGE, "text/html; charset=utf-8")
        if path == "/api/state":
            return self.send(200, json.dumps(state()))
        m = re.fullmatch(r"/shot/(\d+)/([\w.-]+\.png)", path)
        if m:
            p = WT / m.group(1) / "review" / m.group(2)
            if p.is_file():
                return self.send(200, p.read_bytes(), "image/png")
        self.send(404, '{"error":"not found"}')

    def do_POST(self):
        try:
            body = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))) or "{}")
        except ValueError:
            return self.send(400, '{"error":"bad request"}')
        action = self.path
        if action == "/api/play":
            t = str(body.get("target", ""))
            code, out = (start_play(t) if t == "main" or t.isdigit() else (1, "nothing to play"))
        elif action == "/api/play/stop":
            code, out = stop_play()
        else:
            try:
                n = str(int(body.get("n", 0)))
            except (ValueError, TypeError):
                return self.send(400, '{"error":"bad request"}')
            if action == "/api/start":
                model = body.get("model") if body.get("model") in MODELS else MODELS[0]
                code, out = run(["zwork", "start", n, model])
            elif action == "/api/say":
                msg = str(body.get("message", "")).strip()
                code, out = (1, "say something first") if not msg else run(["zwork", "say", n, msg])
            elif action == "/api/stop":
                code, out = run(["zwork", "stop", n])
            elif action == "/api/approve":
                code, out = approve(int(n))
            else:
                return self.send(404, '{"error":"not found"}')
        self.send(200 if code == 0 else 409, json.dumps({"ok": code == 0, "message": out[-600:]}))


