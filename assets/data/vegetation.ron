// Where the instanced grass, flowers and stones grow and how dry they are
// (crates/client/src/vegetation.rs, meshgen/landscape.rs). Only the look. Every field is optional;
// one left out takes the value shown.
(
    // Added to every patch's dryness (0 fresh green .. 1 straw).
    dry: 0.25,
    // Ground at least this rough (0 mown .. 1 wild) grows long grass.
    long_from: 0.45,
    // How big patches are drawn: all of them, and long grass on top of that.
    scale: 1.0,
    long_scale: 1.1,
    // Wildflowers: how many (1 = as many as the ground gives), and how much of the ground their
    // drifts cover (0 none .. 1 all).
    flowers: 2.2,
    flower_cover: 0.5,
    // The chance of small stones on a tile of soft ground beside a road, pavement or path, and on
    // a tile of bare dirt.
    verge_stones: 0.2,
    dirt_stones: 0.25,
)
