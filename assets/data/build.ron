// The build menu: what a survivor can build, and on what. Schema: zombye_sim::build::BuildDef
// (validated on load against items.ron; unknown fields are refused). All builds and numbers are
// our own. Shift+B opens the build menu; a door or window's right-click menu has its builds too.
//
//   id           lowercase letters, digits and _ (saves, tools and Intent::Build name builds by it)
//   name         what it's called in the build menu and in notes
//   description  a line for the build menu
//   category     the build menu's section: Barricades (more to come: walls, floors, furniture, upgrades)
//   on           what it goes on: Window (shut, open or broken) or Door (shut or broken)
//   secs         seconds each piece takes (Handiwork makes it faster, as crafting)
//   inputs       [(item: "id", count: n)]: used up by each piece (whole items, carried or held)
//   tools        [Item("id")] or [Tag("tag")]: needed to hand, kept
//   hp           hit points of each piece against zombies battering it (a shut door has 40, glass 6; a zombie does about 1 every 1.6 s)
//   max          pieces it stacks up to on one window or door
//   noise        metres putting a piece up is heard; break_noise, a piece battered down
//   xp           Handiwork XP for each piece
//   remove       taking a piece down again: secs, tools, what each piece gives back (returns), noise
[
    // ---- Barricades -----------------------------------------------------------------------------
    // A plank nailed across a window from the side you stand on. Each one is a door's worth of
    // battering less than a door, four of them a good deal more; the window stays a window under
    // them (glass and all) when the last one goes.
    (id: "board_window", name: "Board up a window",
        description: "Nail a plank across the window. Up to four; zombies batter them down one by one.",
        category: Barricades, on: Window, secs: 5.0,
        inputs: [(item: "wooden_plank"), (item: "nail", count: 4)], tools: [Tag("hammers")],
        hp: 60.0, max: 4, noise: 22.0, break_noise: 30.0, xp: 4.0,
        remove: (secs: 4.0, tools: [Tag("pries")], returns: [(item: "wooden_plank")], noise: 12.0)),
    // The same across a shut or broken door: more planks for the bigger opening.
    (id: "board_door", name: "Board up a door",
        description: "Nail a plank across the door. Up to five; the door still has to be battered through once they're down.",
        category: Barricades, on: Door, secs: 6.0,
        inputs: [(item: "wooden_plank"), (item: "nail", count: 4)], tools: [Tag("hammers")],
        hp: 60.0, max: 5, noise: 22.0, break_noise: 30.0, xp: 4.0,
        remove: (secs: 5.0, tools: [Tag("pries")], returns: [(item: "wooden_plank")], noise: 12.0)),
]
