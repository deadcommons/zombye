        "floor_concrete_1": ("#808080", 0.9, 0.0),
        "floor_concrete_2": ("#858580", 0.9, 0.0),
        "floor_road_line": ("#9e8c47", 0.9, 0.0),

        // Grey-box furniture, for kinds with no model (meshgen.rs)
        "greybox_bed": ("#6b4c38", 0.9, 0.0),
        "greybox_bed_sheet": ("#ccc7bd", 0.9, 0.0),
        "greybox_wardrobe": ("#66472e", 0.9, 0.0),
        "greybox_fridge": ("#dbdbd6", 0.9, 0.0),
        "greybox_stove": ("#333336", 0.9, 0.0),
