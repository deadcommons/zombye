    sets: {
        // Lawns in broad patches: three close olive greens
        "lawn": ["lawn_1", "lawn_2", "lawn_3"],
        "flowers": ["flower_red", "flower_cream", "flower_mustard", "flower_mauve"],
        "shrub": ["shrub_1", "shrub_2"],
        "forest_floor": ["forest_floor_1", "forest_floor_2"],
        "fern": ["fern_1", "fern_2"],
        // Broadleaf crowns: two or three of these per tree
        "leaf": ["leaf_deep", "leaf_mid", "leaf_olive", "leaf_dusty"],
        "birch_leaf": ["birch_leaf_1", "birch_leaf_2"],
        "pine": ["pine_1", "pine_2"],
        "spruce": ["spruce_1", "spruce_2"],
        // One per house (the generator picks by index, so keep the first eight in this order)
        "siding": ["siding_cream", "siding_almond", "siding_butter", "siding_dusty_blue", "siding_sage", "siding_grey", "siding_tan", "siding_oxblood"],
        "roof": ["roof_slate", "roof_brown", "roof_rust", "roof_moss", "roof_slate_blue"],
        // Shops and offices, by their siding pick
        "brick": ["brick_buff", "brick_tan", "brick_red"],
        "awning": ["awning_red", "awning_green", "awning_blue", "awning_ochre"],
        // Floors: a colour between the two, by tile (tile floors alternate them)
        "floor_grass": ["floor_grass_1", "floor_grass_2"],
        "floor_dirt": ["floor_dirt_1", "floor_dirt_2"],
        "floor_asphalt": ["floor_asphalt_1", "floor_asphalt_2"],
        "floor_sidewalk": ["floor_sidewalk_1", "floor_sidewalk_2"],
        "floor_path": ["floor_path_1", "floor_path_2"],
        "floor_wood": ["floor_wood_1", "floor_wood_2"],
        "floor_carpet": ["floor_carpet_1", "floor_carpet_2"],
        "floor_tile": ["floor_tile_1", "floor_tile_2"],
        "floor_concrete": ["floor_concrete_1", "floor_concrete_2"],
    },
)
