// Electricity and room lights (`zombye_sim::power`). Every field is optional.
(
    grid: (
        // The town's grid is on when the world begins.
        on: true,
        // Game hours after the world began when the grid fails for good: None, it never does
        // (Some(72.0): three days of power).
        fails_after_hours: None,
    ),
    // The town's running water. While it runs, a tap within reach (one of `taps`, furniture
    // kinds, in the room you stand in) fills an empty bottle (recipes.ron: `water: true`).
    water: (
        // Running when the world begins.
        on: true,
        // Game hours after the world began when it goes off for good: None, it never does
        // (Some(72.0): three days of water).
        fails_after_hours: None,
        taps: ["sink", "bathtub", "toilet"],
        // Metres from a tap's footprint you can use it from.
        reach: 1.6,
        // Once the water is off, each piece of furniture of these kinds still holds `fills` fills
        // of dirty water in its cistern (an item's `fills_dirty` in items.ron: boil it to drink).
        cisterns: (kinds: ["toilet"], fills: 3),
    ),
    // Fridges keep food while their building has power: food in one goes off `spoil_mult` as
    // fast (0.25: it lasts four times as long). `containers`: container kinds (containers.ron).
    fridges: (
        containers: ["fridge"],
        spoil_mult: 0.25,
    ),
    // The share of rooms (not halls, porches or garages) with a light left on at the start.
    lights_on_at_start: 0.22,
    // How well zombies, and other survivors, see you in a lit room at night, as daylight
    // (0 dark, 1 broad day): a light left on gives you away through the windows.
    lit_room_seen: 0.8,
)
