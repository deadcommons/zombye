// Recipes: what a survivor can make from what it carries. Schema: zombye_sim::crafting::RecipeDef
// (validated on load against items.ron; unknown fields are refused). All recipes and numbers are
// our own.
//
//   id       lowercase letters, digits and _ (saves and tools name recipes by it)
//   name     what it's called in the inventory panel and in notes
//   secs     seconds it takes (Handiwork, #46, makes it 10% faster per level)
//   inputs   [(item: "id", count: n)]: used up (count defaults to 1). Only whole items count: a
//            part-drunk bottle won't do. Carried or held, not worn (take it off first).
//   tools    [Item("id")] or [Tag("tag")] (any item with that tag in items.ron): needed, kept
//   outputs  [(item: "id", count: n)]: made, into pockets and bags while they have room, the rest
//            at your feet. An output can't also be an input. Empty for a recipe that only places.
//   heat     true: cooking. Only made within reach of a lit campfire or a working stove (a stove
//            needs its building's power). Cooked food is made fresh.
//   places   Some(Campfire): also puts a lit campfire down a metre in front of you, outdoors, its
//            first fuel the inputs tagged fuel (fire.ron: hours a kg). Feed it from its menu.
//   water    true: needs running water. Only made within reach of a tap (power.ron's water.taps:
//            sinks and baths, in the room you stand in) while the town's water is on.
//   repairs  Some((tag: "t", knocks: n)): mends the most worn weapon you hold or carry that has
//            item tag t, taking n knocks off its wear (weapons.ron's durability); a broken one
//            works again. Can't be made with nothing worn to mend. Outputs may then be empty.
[
    // ---- Rags from cloth ------------------------------------------------------------------------
    (id: "rip_t_shirt", name: "Rip a T-shirt into rags", secs: 3.0,
        inputs: [(item: "t_shirt")], outputs: [(item: "rag", count: 3)]),
    (id: "rip_jumper", name: "Rip a jumper into rags", secs: 4.0,
        inputs: [(item: "jumper")], outputs: [(item: "rag", count: 4)]),
    (id: "rip_hoodie", name: "Rip a hoodie into rags", secs: 5.0,
        inputs: [(item: "hoodie")], outputs: [(item: "rag", count: 5)]),
    // Denim won't tear by hand: cut it.
    (id: "cut_jeans", name: "Cut jeans into rags", secs: 6.0,
        inputs: [(item: "jeans")], tools: [Tag("cuts")], outputs: [(item: "rag", count: 4)]),
    (id: "rip_bed_sheet", name: "Tear a bed sheet into rags", secs: 5.0,
        inputs: [(item: "bed_sheet")], outputs: [(item: "rag", count: 6)]),
    (id: "rip_towel", name: "Rip a towel into rags", secs: 4.0,
        inputs: [(item: "towel")], outputs: [(item: "rag", count: 4)]),

    // ---- Dressings ------------------------------------------------------------------------------
    // A rag dresses a wound dirty (it may fester); washed in clean water it goes on clean, like gauze.
    (id: "wash_rags", name: "Wash rags in clean water", secs: 12.0,
        inputs: [(item: "rag", count: 3), (item: "water_bottle")], outputs: [(item: "clean_rag", count: 3), (item: "empty_bottle")]),

    // ---- Water ----------------------------------------------------------------------------------
    // Filling a container at a tap isn't written here: an item's `fills` in items.ron makes its
    // recipe (`fill_<item id>`, zombye_sim::crafting::add_fill_recipes).

    // ---- Mending weapons (zombye_sim::wear) --------------------------------------------------------
    // Duct tape round a split handle or a cracked bat buys a few more fights. A worn weapon can't be
    // an input (only whole things are), so mend it before you build on it.
    (id: "tape_wooden_weapon", name: "Tape up a wooden weapon", secs: 8.0,
        inputs: [(item: "duct_tape")], repairs: Some((tag: "mend_wood", knocks: 3))),
    (id: "tape_handle", name: "Tape a loose handle", secs: 8.0,
        inputs: [(item: "duct_tape")], repairs: Some((tag: "mend_handle", knocks: 3))),
    (id: "beat_out_dents", name: "Beat out the dents and tape it", secs: 12.0,
        inputs: [(item: "duct_tape")], tools: [Tag("hammers")], repairs: Some((tag: "mend_metal", knocks: 3))),

    // ---- Weapons -----------------------------------------------------------------------------------
    (id: "make_nailed_bat", name: "Drive nails through a bat", secs: 20.0,
        inputs: [(item: "baseball_bat"), (item: "nail", count: 6)], tools: [Tag("hammers")], outputs: [(item: "nailed_bat")]),
    (id: "make_spear", name: "Tape a knife to a plank: a spear", secs: 25.0,
        inputs: [(item: "kitchen_knife"), (item: "wooden_plank"), (item: "duct_tape")], outputs: [(item: "spear")]),

    // ---- Fire ---------------------------------------------------------------------------------
    (id: "build_campfire", name: "Build a campfire", secs: 15.0,
        inputs: [(item: "firewood", count: 2)], tools: [Tag("fire")], places: Some(Campfire)),
    (id: "build_campfire_planks", name: "Build a campfire from planks", secs: 15.0,
        inputs: [(item: "wooden_plank", count: 2)], tools: [Tag("fire")], places: Some(Campfire)),
    // Breaking a plank up with a saw or an axe: firewood stacks and packs better than planks.
    (id: "saw_firewood", name: "Saw a plank into firewood", secs: 10.0,
        inputs: [(item: "wooden_plank")], tools: [Tag("saws")], outputs: [(item: "firewood")]),

    // ---- Cooking (over a lit campfire or a working stove) --------------------------------------
    (id: "cook_chicken", name: "Cook the chicken", secs: 20.0, heat: true,
        inputs: [(item: "raw_chicken")], tools: [Tag("cookware")], outputs: [(item: "cooked_chicken")]),
    (id: "cook_sausages", name: "Cook the sausages", secs: 15.0, heat: true,
        inputs: [(item: "sausages")], tools: [Tag("cookware")], outputs: [(item: "cooked_sausages")]),
    (id: "scramble_eggs", name: "Scramble some eggs", secs: 8.0, heat: true,
        inputs: [(item: "egg", count: 2)], tools: [Tag("cookware")], outputs: [(item: "scrambled_eggs")]),
    (id: "boil_pasta", name: "Boil pasta", secs: 25.0, heat: true,
        inputs: [(item: "dry_pasta"), (item: "water_bottle")], tools: [Tag("pot")], outputs: [(item: "cooked_pasta"), (item: "empty_bottle")]),
    (id: "boil_rice", name: "Boil rice", secs: 25.0, heat: true,
        inputs: [(item: "dry_rice"), (item: "water_bottle")], tools: [Tag("pot")], outputs: [(item: "cooked_rice"), (item: "empty_bottle")]),
    (id: "boil_water", name: "Boil dirty water", secs: 20.0, heat: true,
        inputs: [(item: "dirty_water_bottle")], tools: [Tag("pot")], outputs: [(item: "water_bottle")]),
    (id: "heat_soup", name: "Heat a tin of soup", secs: 10.0, heat: true,
        inputs: [(item: "tinned_soup")], tools: [Tag("opens_tins"), Tag("cookware")], outputs: [(item: "hot_soup")]),
    (id: "heat_beans", name: "Heat a tin of beans", secs: 10.0, heat: true,
        inputs: [(item: "tinned_beans")], tools: [Tag("opens_tins"), Tag("cookware")], outputs: [(item: "hot_beans")]),

    // ---- Building (build.ron uses these) --------------------------------------------------------
    (id: "open_nails", name: "Open a box of nails", secs: 1.0,
        inputs: [(item: "nails")], outputs: [(item: "nail", count: 50)]),
    // ---- Wood ----------------------------------------------------------------------------------
    // Logs come from trees felled with an axe (zombye_sim::trees). Planks board up windows and doors.
    (id: "saw_log_planks", name: "Saw a log into planks", secs: 30.0,
        inputs: [(item: "log")], tools: [Tag("saws")], outputs: [(item: "wooden_plank", count: 3)]),
    // Split with a hatchet or an axe where it lies: firewood for a campfire, four to a log.
    (id: "split_log", name: "Split a log into firewood", secs: 20.0,
        inputs: [(item: "log")], tools: [Tag("chops")], outputs: [(item: "firewood", count: 4)]),
]
