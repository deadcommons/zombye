        (kind: "garden_bed", place: Yard, chance: 0.15),
        (kind: "washing_line", place: Yard, chance: 0.2),
        (kind: "garden_table", place: Yard, chance: 0.2),
        (kind: "rotary_line", place: Yard, chance: 0.12),
        (kind: "barbecue", place: Yard, chance: 0.25),
        (kind: "sun_lounger", place: Yard, chance: 0.12),
        (kind: "deckchair", place: Yard, chance: 0.25),
        (kind: "doghouse", place: Yard, chance: 0.12),
        (kind: "wheelbarrow", place: Yard, chance: 0.12),
        (kind: "rubbish_pile", place: Yard, chance: 0.12),
