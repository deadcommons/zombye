// Small one-storey bungalow. One character per tile; "." is outside.
// The bottom row is the front of the house and faces the street.
// Openings are (x, y, side): side N/E/S/W of tile (x, y).
BuildingTemplate(
    id: "house_bungalow",
    name: "Small bungalow",
    kind: House,
    roof: GableX,
    rooms: {
        'B': (name: "Bedroom", room_type: "bedroom", floor: Carpet),
        'b': (name: "Bathroom", room_type: "bathroom", floor: TileFloor),
        'H': (name: "Hall", room_type: "hall", floor: Wood),
        'K': (name: "Kitchen", room_type: "kitchen", floor: TileFloor),
        'L': (name: "Living room", room_type: "living", floor: Wood),
    },
    levels: [
        (
            layout: [
                "BBBBbbbKKK",
                "BBBBbbbKKK",
                "BBBBbbbKKK",
                "BBBBHHHKKK",
                "LLLLHHHKKK",
                "LLLLLLLKKK",
                "LLLLLLLKKK",
                "LLLLLLLKKK",
            ],
            doors: [
                (2, 7, S), // front door
                (8, 0, N), // back door
                (3, 3, E), // bedroom
                (5, 2, S), // bathroom
            ],
            arches: [(5, 4, S), (6, 6, E)],
            windows: [
                (0, 1, W), (2, 0, N),
                (5, 0, N),
                (9, 2, E), (9, 5, E), (8, 7, S),
                (0, 6, W), (4, 7, S),
            ],
            furniture: [
                (kind: "bed", at: (1, 0), size: (2, 2)),
                (kind: "wardrobe", at: (3, 0)),
                (kind: "bathtub", at: (4, 0), size: (1, 2), facing: E),
                (kind: "toilet", at: (6, 0)),
                (kind: "sink", at: (6, 2), facing: W),
                (kind: "fridge", at: (7, 0)),
                (kind: "counter", at: (9, 0), size: (1, 2), facing: W),
                (kind: "stove", at: (9, 3), facing: W),
                (kind: "table", at: (8, 4), size: (1, 2)),
                (kind: "sofa", at: (0, 5), size: (1, 2), facing: E),
                (kind: "coffee_table", at: (1, 5)),
                (kind: "tv", at: (3, 4), facing: W),
            ],
        ),
    ],
)
