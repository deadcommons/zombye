// Narrow two-storey townhouse, gable end to the street: a side hall with the stairs, living room,
// dining room and kitchen one behind the other. One character per tile; "." is outside.
// The bottom row is the front of the house and faces the street.
// Openings are (x, y, side): side N/E/S/W of tile (x, y).
BuildingTemplate(
    id: "house_townhouse",
    name: "Narrow townhouse",
    kind: House,
    roof: GableY,
    rooms: {
        'K': (name: "Kitchen", room_type: "kitchen", floor: TileFloor),
        'D': (name: "Dining room", room_type: "dining", floor: Wood),
        'L': (name: "Living room", room_type: "living", floor: Wood),
        'H': (name: "Hall", room_type: "hall", floor: Wood),
        'b': (name: "Bathroom", room_type: "bathroom", floor: TileFloor),
        'C': (name: "Back bedroom", room_type: "bedroom", floor: Carpet),
        'B': (name: "Small bedroom", room_type: "bedroom", floor: Carpet),
        'M': (name: "Front bedroom", room_type: "bedroom", floor: Carpet),
    },
    levels: [
        (
            layout: [
                "KKKKKKK",
                "KKKKKKK",
                "KKKKKKK",
                "KKKKKKK",
                "DDDDDbb",
                "DDDDDbb",
                "DDDDDHH",
                "DDDDDHH",
                "LLLLLHH",
                "LLLLLHH",
                "LLLLLHH",
                "LLLLLHH",
                "LLLLLHH",
                "LLLLLHH",
            ],
            doors: [
                (5, 13, S), // front door
                (5, 0, N), // back door
                (5, 6, N), // downstairs toilet
            ],
            arches: [(2, 3, S), (1, 7, S), (2, 7, S), (5, 7, W), (4, 12, E)],
            windows: [
                (1, 0, N), (0, 2, W), (6, 2, E),
                (0, 5, W), (0, 6, W),
                (6, 4, E),
                (0, 9, W), (0, 12, W), (1, 13, S), (3, 13, S),
                (6, 13, S),
            ],
            furniture: [
                (kind: "fridge", at: (0, 0)),
                (kind: "counter", at: (1, 0), size: (2, 1)),
                (kind: "stove", at: (3, 0)),
                (kind: "sink", at: (4, 0)),
                (kind: "counter", at: (6, 0), size: (1, 2), facing: W),
                (kind: "table", at: (2, 2), size: (2, 1)),
                (kind: "shelf", at: (4, 4), facing: W),
                (kind: "table", at: (1, 5), size: (2, 1)),
                (kind: "sink", at: (5, 4)),
                (kind: "toilet", at: (6, 4)),
                (kind: "stairs", at: (6, 8), size: (1, 3), facing: N),
                (kind: "wardrobe", at: (6, 12), facing: W),
                (kind: "sofa", at: (0, 10), size: (1, 2), facing: E),
                (kind: "coffee_table", at: (2, 10)),
                (kind: "tv", at: (4, 10), facing: W),
            ],
        ),
        (
            layout: [
                "CCCCCCC",
                "CCCCCCC",
                "CCCCCCC",
                "CCCCCCC",
                "bbbbHHH",
                "bbbbHHH",
                "BBBBBHH",
                "BBBBBHH",
                "BBBBBHH",
                "MMMMMHH",
                "MMMMMHH",
                "MMMMMHH",
                "MMMMMHH",
                "MMMMMHH",
            ],
            doors: [(5, 4, N), (4, 5, W), (5, 7, W), (5, 11, W)],
            windows: [
                (1, 0, N), (5, 0, N), (0, 2, W), (6, 2, E),
                (0, 5, W),
                (0, 7, W),
                (0, 12, W), (1, 13, S), (3, 13, S),
                (6, 12, E), (6, 13, S),
            ],
            furniture: [
                (kind: "wardrobe", at: (0, 0)),
                (kind: "bed", at: (2, 0), size: (2, 2)),
                (kind: "desk", at: (6, 1), facing: W),
                (kind: "bathtub", at: (0, 4), size: (2, 1)),
                (kind: "toilet", at: (2, 4)),
                (kind: "sink", at: (3, 4)),
                (kind: "bed", at: (0, 6), size: (2, 2), facing: E),
                (kind: "wardrobe", at: (4, 6)),
                (kind: "desk", at: (3, 8), facing: N),
                (kind: "wardrobe", at: (4, 9)),
                (kind: "bed", at: (0, 10), size: (2, 2), facing: E),
                (kind: "desk", at: (0, 13), facing: N),
            ],
        ),
    ],
)
