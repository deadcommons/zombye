// What furniture holds. Schema: zombye_sim::loot::LootData (validated on load against items.ron
// and containers.ron; unknown fields are refused). All names, weights and odds are our own.
//
// A table is keyed by (room type, container kind), either of which may be "any". A container uses
// the first table of: (room, container), (any, container), (room, any), (any, any); with none it
// holds nothing. So a fridge is a fridge wherever it stands unless a room says otherwise, and
// furniture whose kind has no "any" table here (shelves, a workbench) holds what its room holds.
//
// A table: `empty` (chance it holds nothing at all), `rolls` (how many picks, (min, max)), and
// `entries`: an item id, a `weight` among the table's entries (default 1), a `count` per pick
// ((min, max), default (1, 1)) and a rarity `tier`: Common (the default), Uncommon, Rare or
// VeryRare. A tier multiplies the weight by its number in `tiers` below, so what's valuable is
// rare wherever it's listed, and one number makes a whole tier rarer or commoner. (`rare: true`,
// the older way, still works: the weight times `rare_scale`.)
// `groups` are extra lists rolled after the picks, each with a `chance` and its own `rolls`. The
// same item picked twice adds up; a pick that doesn't fit in the container's room is cut to what
// fits, or skipped.
//
// A container is filled the first time anyone opens it, from a hash of the game's loot seed and
// its id (never the world's random stream), so it holds the same whenever and in whatever order
// houses are searched. Every new game and new run has a fresh loot seed (`--loot-seed S` fixes
// it), so the same town holds different things each game. Editing this file only changes containers nobody has opened yet: a save made
// before loads with a note.
//
// Room types now in the templates: kitchen (offices' break rooms too), bathroom, bedroom, living,
// dining, hall, laundry, porch, garage, office, and the shops' shop, pharmacy and hardware (a shop's
// stock is its room type: shelves and workbenches there have no table of their own, so they fill
// from the room's). The shed table is ready for a shed.
(
    // Sandbox loot abundance: multiplies every table's and group's rolls (0.25 scarce ... 2 plenty).
    scale: 1.0,
    // Multiplies the weight of Rare and VeryRare entries (0: never found).
    rare_scale: 1.0,
    // Each tier's weight multiplier. Roughly: a Common entry of weight 1 in a table of everyday
    // things turns up in one container in eight or so, an Uncommon one in one in twenty, a Rare one
    // in one in fifty, a VeryRare one in one in a hundred and more: a gun or two in a town.
    tiers: (common: 1.0, uncommon: 0.35, rare: 0.15, very_rare: 0.08),
    tables: [
        // ---- Kitchen -------------------------------------------------------------------------
        (room: "kitchen", container: "fridge", empty: 0.15, rolls: (1, 4), entries: [
            (item: "soda_can", weight: 3, count: (1, 4)),
            (item: "milk", weight: 3),
            (item: "cheese", weight: 3),
            (item: "apple", weight: 3, count: (1, 4)),
            (item: "juice_carton", weight: 2, count: (1, 2)),
            (item: "water_bottle", weight: 2, count: (1, 2)),
            (item: "bread", weight: 1),
        ]),
        (room: "kitchen", container: "kitchen_cupboard", empty: 0.1, rolls: (2, 5), entries: [
            (item: "tinned_beans", weight: 4, count: (1, 3)),
            (item: "tinned_soup", weight: 4, count: (1, 3)),
            (item: "tinned_fruit", weight: 3, count: (1, 2)),
            (item: "crackers", weight: 3),
            (item: "cereal", weight: 3),
            (item: "crisps", weight: 2),
            (item: "mug", weight: 4, count: (1, 2)),
            (item: "empty_bottle", weight: 2),
            (item: "plastic_bag", weight: 2, count: (1, 3)),
            (item: "matches", weight: 1),
            (item: "peanut_butter", weight: 3, tier: Uncommon),
            (item: "frying_pan", weight: 2, tier: Uncommon),
        ], groups: [
            // One cupboard in three is the one with the cutlery drawer.
            (name: "cutlery drawer", chance: 0.35, rolls: (1, 1), entries: [
                (item: "tin_opener", weight: 3),
                (item: "kitchen_knife", weight: 4, tier: Uncommon),
                (item: "scissors", weight: 2, tier: Uncommon),
            ]),
        ]),
        (room: "kitchen", container: "under_sink", empty: 0.3, rolls: (1, 2), entries: [
            (item: "plastic_bag", weight: 3, count: (1, 3)),
            (item: "rag", weight: 2, count: (1, 2)),
            (item: "candle", weight: 2),
            (item: "empty_bottle", weight: 1),
            (item: "duct_tape", weight: 3, tier: Uncommon),
            (item: "antiseptic", weight: 2, tier: Uncommon),
        ]),
        // Any shelves in a kitchen: the pantry.
        (room: "kitchen", container: "any", empty: 0.2, rolls: (1, 4), entries: [
            (item: "tinned_beans", weight: 3, count: (1, 2)),
            (item: "tinned_soup", weight: 3, count: (1, 2)),
            (item: "cereal", weight: 2),
            (item: "crackers", weight: 2),
            (item: "mug", weight: 2),
            (item: "baking_tray", weight: 1),
        ]),

        // ---- Containers that are the same in any room -----------------------------------------
        (room: "any", container: "fridge", empty: 0.3, rolls: (1, 3), entries: [
            (item: "soda_can", weight: 4, count: (1, 4)),
            (item: "water_bottle", weight: 3, count: (1, 2)),
