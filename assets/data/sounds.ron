        GlassBreak: (files: ["sfx/glass_break_1.wav", "sfx/glass_break_2.wav"], volume: 1.0, pitch: (0.92, 1.08), reach: 60.0, muffle: 0.5, voices: 3),
        DoorBreak: (files: ["sfx/door_break_1.wav", "sfx/door_break_2.wav"], volume: 1.0, pitch: (0.9, 1.05), reach: 60.0, muffle: 0.5, voices: 2),
