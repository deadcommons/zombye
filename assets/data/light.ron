// How the light looks (crates/client/src/daynight.rs): the sun, the light that fills shadows, and
// the camera's grade and vignette, by day and at night (in between follows the daylight). Only the
// look: what zombies see by is the simulation's own. Every field is optional; one left out takes
// the value shown.
(
    sun: (
        // Brightness at full daylight, in lux.
        lux: 16000.0,
        // How high it stands: `low` at the horizon's end of the day plus `climb` at noon, against
        // 1 along the ground (0.2 + 0.4 is about 47 degrees up at noon), tilted `south`.
        low: 0.2,
        climb: 0.4,
        south: 0.55,
        // Its colour (sRGB) at its highest, and toward dawn and dusk.
        colour_high: (1.0, 0.88, 0.7),
        colour_low: (1.0, 0.64, 0.34),
    ),
    // The moon: its brightness in lux and its colour (sRGB).
    moon: (lux: 1100.0, colour: (0.55, 0.65, 1.0)),
    // How wide the sun and moon are, as the size of a soft shadow's edge: 0 = hard-edged. Drawn
    // only with "Soft shadows" on in the graphics settings.
    soft_shadows: 6.0,
    // The light in the shadows: its colour (sRGB) and brightness.
    fill_day: (colour: (0.86, 0.74, 0.62), brightness: 520.0),
    fill_night: (colour: (0.3, 0.38, 0.66), brightness: 40.0),
    // The camera's grade. `shadows`: saturation, contrast, lift. `midtones`: saturation, contrast.
    // `highlights`: saturation, gain. `vignette`: intensity, radius.
    grade_day: (
        exposure: 0.45,
        temperature: 0.04,
        tint: -0.01,
        saturation: 0.95,
        shadows: (0.9, 1.0, 0.006),
        midtones: (0.97, 1.08),
        highlights: (0.92, 1.1),
        vignette: (0.46, 0.8),
    ),
    grade_night: (
        exposure: 0.35,
        temperature: -0.03,
        tint: 0.0,
        saturation: 0.72,
        shadows: (0.6, 1.0, 0.0),
        midtones: (0.8, 1.04),
        highlights: (1.0, 1.0),
        vignette: (0.6, 0.62),
    ),
    // Added to the temperature and to the saturation at dawn and dusk.
    dusk: (0.06, 0.1),
    // The haze: what stands up the screen from the survivor is washed toward its colour, in slow
    // banks. `colour` (sRGB), `brightness` against sunlit ground and `strength` (how much of what
    // stands in it it takes at most, 0 = none) are for a low sun, at dawn and dusk; `day` and
    // `day_colour` the same for the thin veil with the sun high (day: 0 = none by day). `near` and
    // `far`: how many metres from the survivor it starts and is thickest, at the default zoom (they
    // follow the zoom). Drawn only with "Haze" on in the graphics settings.
    haze: (colour: (1.0, 0.7, 0.42), brightness: 1.15, strength: 0.26, day: 0.24, day_colour: (0.95, 0.93, 0.86), near: 8.0, far: 34.0),
    // The old look (the settings' "Old look": Off, Subtle, Strong): the picture as a faded print.
    // `fade`: how far the blacks lift toward `ink` (sRGB, a warm brown). `wash`: how far the whites
    // come down to `paper` (sRGB, a warm cream that tints everything through them). `desaturate`:
    // how much colour goes. `grain`: grain added to the film grain's. `glow`: the soft glow round
    // the brightest parts. `night`: the share of `fade` kept at night, so the dark stays dark.
    // Every amount is 0 for none.
    old_look: (
        subtle: (fade: 0.3, ink: (0.3, 0.22, 0.16), wash: 0.45, paper: (0.97, 0.9, 0.76), desaturate: 0.12, grain: 0.05, glow: 0.25, night: 0.35),
        strong: (fade: 0.55, ink: (0.34, 0.25, 0.18), wash: 0.8, paper: (0.95, 0.86, 0.7), desaturate: 0.3, grain: 0.11, glow: 0.45, night: 0.35),
    ),
    // A campfire at night: its colour (sRGB), brightness in lumens, how far its light reaches and
    // how high over the ground it sits (metres), and how far round it what stands in its light is
    // seen in the dark.
    fire: (colour: (1.0, 0.55, 0.22), lumens: 600000.0, range: 14.0, height: 0.7, seen: 7.0),
    // How many times stronger the fill is by day while you are inside a building. Rooms lie in
    // their roof's shadow (the roof casts it whether the camera draws the roof or not), so only
    // the windows let the sun in. 1 = no stronger.
    indoor_fill: 1.6,
    // The sky of the first-person view (the view from above never sees it): colours (sRGB) at
    // the zenith and the horizon in full daylight, with the sun low and at night, blended by the
    // hour. The horizon is also the haze's colour over the far edge of the world. `curve`: how
    // thin the horizon's band is (1 = an even blend up to the zenith). `below`: how much darker
    // under the horizon (0..1). `glow`: the colour round the sun or moon, `glow_strength` against
    // its light, `glow_tightness` (more = a smaller glow); the haze glows the same. The discs:
    // size in degrees across and brightness. `stars`: how many (0..1) and how bright. Drawn only
    // with "Sky" on in the graphics settings.
    sky: (
        zenith_day: (0.33, 0.52, 0.8),
        horizon_day: (0.68, 0.77, 0.87),
        zenith_dusk: (0.3, 0.36, 0.58),
        horizon_dusk: (1.0, 0.68, 0.44),
        zenith_night: (0.02, 0.03, 0.07),
        horizon_night: (0.07, 0.09, 0.13),
        curve: 3.0,
        below: 0.5,
        glow: (1.0, 0.78, 0.55),
        glow_strength: 0.02,
        glow_tightness: 8.0,
        sun_size: 2.0,
        sun_brightness: 30.0,
        moon_size: 1.8,
        moon_brightness: 1.2,
        stars: 0.35,
        star_brightness: 1.0,
    ),
    // Light from the sky in the shade, in both views: `share` of the fill (0..1) comes from
    // around instead of evenly, so what faces up takes the sky's colour, what faces the sun its
    // glow (`sun_side`, how much brighter that side is) and what faces down the sun's light
    // thrown back by the `ground` (sRGB, `bounce` how strongly). `tint`: how much of the sky's
    // own colour it keeps (0 = the fill's colour from every side). The fill as a whole stays as
    // bright as `fill_day` and `fill_night` say. Only with "Sky light" on in the graphics settings.
    sky_light: (share: 0.6, tint: 0.5, ground: (0.5, 0.42, 0.32), bounce: 0.35, sun_side: 0.6),
    // Light shafts: a box of air round the player (`size`: width and height in metres) that the
    // sun's light scatters in, showing as beams where it is broken up, through trees or between
    // houses. `density` how thick (0 = none), `absorption` and `scattering` what it takes out of
    // the light and throws, `asymmetry` how much goes on forward (-1..1; more = brighter looking
    // toward the sun), `colour` (sRGB), `steps` samples a pixel (more = smoother, slower). By
    // day only, and only with "Light shafts" on in the graphics settings (Ultra).
    shafts: (density: 0.02, absorption: 0.1, scattering: 0.35, asymmetry: 0.7, colour: (1.0, 0.95, 0.86), size: (160.0, 24.0), steps: 48),
)
